#!/usr/bin/env bash
. "$(dirname "${BASH_SOURCE[0]}")/../lib/common.sh"

POLL_S=5 SEGMENT_S=540 MAX_FAILS=3
STATUS_RE='"status" *: *"([a-z_]+)"'

fetch_job() {
  local response
  response=$(curl -s --max-time 20 -w '\n%{http_code}' -H "x-api-key: $BIPOLAR_API_KEY" "$JOB_URL")
  bipolar_split_response "$response"
}

read_status() {
  STATUS=
  [[ $HTTP_BODY =~ $STATUS_RE ]] && STATUS=${BASH_REMATCH[1]}
}

stop_when_lost() {
  [ "$HTTP_CODE" = 404 ] || return 0
  echo "job lost: the server no longer knows it (HTTP 404; bipolar-code restarted and jobs live in memory)"
  exit 76
}

count_unreadable() {
  [ -n "$STATUS" ] && { FAILS=0; return 0; }
  FAILS=$((FAILS + 1))
  [ "$FAILS" -lt "$MAX_FAILS" ] && return 0
  printf '%s\n' "$HTTP_BODY"
  echo "status unreadable $FAILS times in a row (last HTTP $HTTP_CODE)"
  exit 74
}

stop_when_finished() {
  case "$STATUS" in
    queued|running|"") return 0 ;;
  esac
  printf '%s\n' "$HTTP_BODY"
  exit 0
}

stop_at_segment_end() {
  [ "$SECONDS" -lt "$DEADLINE" ] && return 0
  printf '%s\n' "$HTTP_BODY"
  echo "job still ${STATUS:-unconfirmed} after this segment: run bipolar-delegate-wait $JOB_ID again"
  exit 75
}

bipolar_require_job_id "$1"
JOB_ID=$1
bipolar_load_config
JOB_URL="$BIPOLAR_URL/api/delegate/jobs/$JOB_ID"
DEADLINE=$((SECONDS + SEGMENT_S)) FAILS=0
while :; do
  fetch_job
  stop_when_lost
  read_status
  count_unreadable
  stop_when_finished
  stop_at_segment_end
  sleep "$POLL_S"
done
